[Unit]
Description=Portfolio news Telegram digest
ConditionPathIsExecutable=%h/portfolio-news/.venv/bin/python
ConditionPathExists=%h/.config/portfolio-news/portfolio-news.env

[Service]
Type=oneshot
WorkingDirectory=%h/portfolio-news
EnvironmentFile=%h/.config/portfolio-news/portfolio-news.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/portfolio-news/.venv/bin/python -m portfolio_news run
TimeoutStartSec=30min
Nice=5
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
CapabilityBoundingSet=
