# Required for research and Google Sheets access.
OPENAI_API_KEY=replace-me
GOOGLE_SPREADSHEET_ID=replace-me
GOOGLE_CREDENTIALS_FILE=~/.config/portfolio-news/google_credentials.json

# Required for live delivery. A dry run does not use these values.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

TZ=Europe/Paris
DATABASE_PATH=~/.local/state/portfolio-news/portfolio_news.db
LOCK_FILE=~/.local/state/portfolio-news/portfolio_news.lock

# Optional controls.
OPENAI_MODEL=gpt-5.6-sol
MAX_HISTORY_ITEMS=100
HISTORY_DAYS=30
MAX_TELEGRAM_CHARS=3500
OPENAI_TIMEOUT_SECONDS=180
HTTP_TIMEOUT_SECONDS=30
MAX_API_ATTEMPTS=3
LOG_LEVEL=INFO
